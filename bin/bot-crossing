#!/usr/bin/env bash
#
# bot-crossing — start, stop and toggle the local Bot Crossing app.
#
# The whole point of this script is that Bot Crossing costs nothing when you are not
# looking at it: no launchd agent, no daemon, no supervisor. `start` forks one plain
# node process and records its PID; `stop` kills that process and leaves nothing behind.
# The macOS app produced by `install-app` is a thin wrapper around `toggle`, so a single
# click in the Dock is the whole user interface for running and quitting the server.
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Where we are
# ---------------------------------------------------------------------------

# Resolve this script's real location so the repo root is right even when bin/bot-crossing
# is reached through a symlink (e.g. someone links it into ~/bin). The .app created by
# install-app calls the absolute path, but a symlinked copy should work too.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link_target="$(readlink "$self")"
  case "$link_target" in
    /*) self="$link_target" ;;
    *) self="$(cd -P "$(dirname "$self")" && pwd)/$link_target" ;;
  esac
done
BIN_DIR="$(cd -P "$(dirname "$self")" && pwd)"
ROOT="$(cd -P "$BIN_DIR/.." && pwd)"
SELF_PATH="$BIN_DIR/$(basename "$self")"

cd "$ROOT"

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

# PORT / BOT_CROSSING_HOST come from the environment so a second copy can run alongside
# the first (server/serve.mjs reads exactly these two variables).
PORT="${PORT:-5274}"
BOT_CROSSING_HOST="${BOT_CROSSING_HOST:-127.0.0.1}"

DATA_DIR="$ROOT/data"
PIDFILE="$DATA_DIR/server.pid"
LOGFILE="$DATA_DIR/server.log"
# Always probe over the loopback address: the server may be bound to 0.0.0.0 or to a LAN
# address, but 127.0.0.1 is what we can reliably reach from this machine.
URL="http://127.0.0.1:$PORT/"
SERVER_ENTRY="server/serve.mjs"

# The wallpaper: one Swift file, compiled locally into a minimal .app bundle. Same bargain as
# the server — a pidfile, a log, and nothing left behind when it is stopped.
WP_DIR="$ROOT/wallpaper"
WP_SOURCE="$WP_DIR/BotCrossingWallpaper.swift"
WP_BUILD="$WP_DIR/build"
WP_APP="$WP_BUILD/Bot Crossing Wallpaper.app"
WP_EXE_NAME="Bot Crossing Wallpaper"
WP_EXE="$WP_APP/Contents/MacOS/$WP_EXE_NAME"
WP_PIDFILE="$DATA_DIR/wallpaper.pid"
WP_LOGFILE="$DATA_DIR/wallpaper.log"
# What the page is told it is. `?wallpaper` turns the HUD off and the colony on; preset=low and
# idle=6 keep a screen nobody is looking at from spending a GPU on it. Harmless if the build
# in dist/ does not know these parameters yet — unknown query keys are simply ignored.
WP_URL_DEFAULT="${URL}?wallpaper&preset=low&idle=6"

# data/ holds the colony state, the pidfile and the log. It is gitignored, and it may not
# exist on a fresh clone, so create it before anything tries to write there.
mkdir -p "$DATA_DIR"

# ---------------------------------------------------------------------------
# Node selection
# ---------------------------------------------------------------------------

# package.json wants Node >= 22.13 because the Codex harness reads thread titles out of
# SQLite through node:sqlite, which only landed in 22.13. On this kind of machine the
# `node` first on PATH is often an older Homebrew keg (22.12), while a newer keg sits
# right next to it — so rather than failing, or forcing the user to fiddle with PATH, we
# look through the usual Homebrew locations and take the first one new enough.
NODE_CANDIDATES=(
  "node"
  "/opt/homebrew/opt/node/bin/node"
  "/opt/homebrew/opt/node@24/bin/node"
  "/opt/homebrew/opt/node@23/bin/node"
  "/opt/homebrew/opt/node@22/bin/node"
)

# node_version_ok BIN — true when BIN reports a version >= 22.13. Major and minor are
# compared as numbers, because a string compare would rank "22.9" above "22.13".
node_version_ok() {
  local bin="$1" raw major minor rest
  raw="$("$bin" --version 2>/dev/null)" || return 1
  raw="${raw#v}"
  major="${raw%%.*}"
  rest="${raw#*.}"
  minor="${rest%%.*}"
  case "$major$minor" in
    *[!0-9]* | "") return 1 ;;
  esac
  if [ "$major" -gt 22 ]; then return 0; fi
  if [ "$major" -eq 22 ] && [ "$minor" -ge 13 ]; then return 0; fi
  return 1
}

NODE_BIN=""

pick_node() {
  # Memoised: several subcommands call this and each call shells out to `node --version`.
  if [ -n "$NODE_BIN" ]; then return 0; fi
  local candidate resolved
  for candidate in "${NODE_CANDIDATES[@]}"; do
    resolved="$(command -v "$candidate" 2>/dev/null || true)"
    [ -n "$resolved" ] || continue
    [ -x "$resolved" ] || continue
    if node_version_ok "$resolved"; then
      NODE_BIN="$resolved"
      # Put the chosen Node first on PATH so `npx vite build` runs under the same
      # interpreter as the server, instead of whatever npx the shell happens to find.
      PATH="$(dirname "$NODE_BIN"):$PATH"
      export PATH
      return 0
    fi
  done
  # No new-enough Node anywhere: still run, but say what will be missing rather than
  # refusing to start the whole app over one optional feature.
  NODE_BIN="$(command -v node 2>/dev/null || echo node)"
  echo "warning: no Node >= 22.13 found; Codex thread titles need 22.13+ (using $("$NODE_BIN" --version 2>/dev/null || echo unknown))" >&2
  return 0
}

# ---------------------------------------------------------------------------
# Process helpers
# ---------------------------------------------------------------------------

# pid_alive PID — the process exists and we may signal it.
pid_alive() {
  local pid="${1:-}"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

# pid_is_server PID — the process is *our* server and not some unrelated program that
# happens to have inherited the same PID number after a reboot or a PID wrap. We check
# the recorded command line rather than trusting the pidfile, because killing a stranger
# because of a stale file is the one genuinely destructive thing this script could do.
pid_is_server() {
  local pid="${1:-}" cmd
  [ -n "$pid" ] || return 1
  cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
  case "$cmd" in
    *"$SERVER_ENTRY"*) return 0 ;;
    *) return 1 ;;
  esac
}

# read_pid [FILE] — the PID recorded in FILE (the server's pidfile by default), or nothing at
# all if the file is missing, empty or does not hold a plain number.
read_pid() {
  local file="${1:-$PIDFILE}"
  [ -f "$file" ] || return 1
  local pid
  pid="$(tr -d '[:space:]' <"$file" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  case "$pid" in
    *[!0-9]*) return 1 ;;
  esac
  printf '%s' "$pid"
}

# port_answers — the server is actually serving, not merely a live process that is stuck
# or still booting. This is what makes `start` idempotent.
port_answers() {
  curl -fsS --max-time 2 -o /dev/null "$URL" 2>/dev/null
}

# is_running — the strict definition used by start/status/toggle: a recorded process that
# is alive *and* a port that answers.
is_running() {
  local pid
  pid="$(read_pid || true)"
  [ -n "$pid" ] || return 1
  pid_alive "$pid" || return 1
  port_answers || return 1
  return 0
}

# port_listeners — PIDs holding the TCP port open. Used only as a safety net in `stop`.
port_listeners() {
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true
}

notify() {
  # A failing notification must never fail the command the user actually asked for —
  # osascript can be blocked by TCC, or absent entirely in a stripped environment.
  osascript -e "display notification \"$1\" with title \"Bot Crossing\"" >/dev/null 2>&1 || true
}

open_url() {
  # BOT_CROSSING_NO_OPEN=1 is the environment equivalent of --no-open, so scripts and
  # tests can drive this without a browser window appearing.
  if [ "${BOT_CROSSING_NO_OPEN:-}" = "1" ]; then return 0; fi
  open "$URL" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

ensure_deps() {
  if [ ! -d "$ROOT/node_modules" ]; then
    echo "Installing dependencies…"
    # --ignore-scripts: nothing in this project needs postinstall hooks, and skipping them
    # keeps a double-click launch from running arbitrary package code.
    npm ci --ignore-scripts
  fi
}

# needs_build — true when dist/ is missing or older than any source file. Rebuilding
# unconditionally would add ~10s of vite to every single click on the Dock icon, and the
# common case is that nothing changed since the last run, so compare mtimes instead.
needs_build() {
  [ -f "$ROOT/dist/index.html" ] || return 0
  local sources=() newer
  [ -d "$ROOT/src" ] && sources+=("$ROOT/src")
  [ -d "$ROOT/public" ] && sources+=("$ROOT/public")
  [ -f "$ROOT/index.html" ] && sources+=("$ROOT/index.html")
  [ -f "$ROOT/vite.config.js" ] && sources+=("$ROOT/vite.config.js")
  [ ${#sources[@]} -gt 0 ] || return 1
  newer="$(find "${sources[@]}" -type f -newer "$ROOT/dist/index.html" -print 2>/dev/null | head -n 1 || true)"
  [ -n "$newer" ]
}

run_build() {
  echo "Building…"
  npx vite build
}

ensure_build() {
  ensure_deps
  if needs_build; then
    run_build
  fi
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_start() {
  local no_open=0 arg
  for arg in "$@"; do
    case "$arg" in
      --no-open) no_open=1 ;;
      *) echo "start: unknown option '$arg'" >&2; return 2 ;;
    esac
  done

  if is_running; then
    local pid
    pid="$(read_pid)"
    echo "Bot Crossing already running → $URL (pid $pid)"
    [ "$no_open" -eq 1 ] || open_url
    return 0
  fi

  # A pidfile can survive a crash or a reboot. Clear it before starting so `status` never
  # reports a PID that belongs to nothing (or to somebody else).
  rm -f "$PIDFILE"

  pick_node
  ensure_build

  # Detached on purpose: nohup plus a full redirect of stdin/stdout/stderr, then disown,
  # so the server outlives this shell — including the very short-lived shell that the
  # .app's `do shell script` gives us.
  PORT="$PORT" BOT_CROSSING_HOST="$BOT_CROSSING_HOST" \
    nohup "$NODE_BIN" "$SERVER_ENTRY" >>"$LOGFILE" 2>&1 </dev/null &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  printf '%s\n' "$pid" >"$PIDFILE"

  # Poll rather than sleeping a fixed amount: usually the port answers in well under a
  # second, and waiting the full timeout would make the Dock click feel broken.
  local waited=0
  while [ "$waited" -lt 32 ]; do
    if port_answers; then
      echo "Bot Crossing running → $URL (pid $pid, log $LOGFILE)"
      [ "$no_open" -eq 1 ] || open_url
      return 0
    fi
    if ! pid_alive "$pid"; then
      rm -f "$PIDFILE"
      echo "Bot Crossing failed to start — last lines of $LOGFILE:" >&2
      tail -n 20 "$LOGFILE" >&2 || true
      return 1
    fi
    sleep 0.25
    waited=$((waited + 1))
  done

  echo "Bot Crossing did not answer on $URL within 8s (pid $pid, log $LOGFILE)" >&2
  return 1
}

cmd_stop() {
  local stopped=0 pid

  # The wallpaper is a window onto this server and nothing else. Taking the server away first
  # would leave a black rectangle on somebody's monitor quietly retrying every thirty seconds, so
  # it goes first — and `stop` still means what it says: nothing of ours left running.
  if wp_is_running; then
    printf 'wallpaper: '
    cmd_wallpaper_stop
  fi

  pid="$(read_pid || true)"
  if [ -n "$pid" ] && pid_alive "$pid" && pid_is_server "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    local waited=0
    while [ "$waited" -lt 12 ] && pid_alive "$pid"; do
      sleep 0.25
      waited=$((waited + 1))
    done
    # Still there after 3s of polite asking — it is not going to close on its own.
    if pid_alive "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.25
    fi
    stopped=1
  fi
  rm -f "$PIDFILE"

  # Safety net for a stale or deleted pidfile: whoever is holding the port is very
  # probably the server we lost track of. We only kill it after confirming its command
  # line mentions server/serve.mjs — the port could just as easily have been taken by the
  # user's own dev server, another project, or something important, and this script must
  # never kill a process it cannot positively identify as ours.
  local lpid w
  # Word splitting on the PID list is intended — lsof -t prints one PID per line.
  for lpid in $(port_listeners); do
    if pid_is_server "$lpid"; then
      kill -TERM "$lpid" 2>/dev/null || true
      w=0
      while [ "$w" -lt 12 ] && pid_alive "$lpid"; do
        sleep 0.25
        w=$((w + 1))
      done
      if pid_alive "$lpid"; then kill -KILL "$lpid" 2>/dev/null || true; fi
      stopped=1
    else
      echo "note: something else is listening on port $PORT (pid $lpid) — left alone" >&2
    fi
  done

  # Confirm rather than assume: a "stopped" that left the server running would be worse
  # than no message at all. If the port still answers we ask who owns it — a stranger
  # squatting on the port is not our failure to report as one.
  sleep 0.25
  if port_answers; then
    local ours_left=0
    for lpid in $(port_listeners); do
      if pid_is_server "$lpid"; then ours_left=1; fi
    done
    if [ "$ours_left" -eq 1 ]; then
      echo "Bot Crossing is still answering on $URL — could not stop it" >&2
      return 1
    fi
    echo "note: port $PORT is still in use by something else; no Bot Crossing server is running" >&2
  fi

  if [ "$stopped" -eq 1 ]; then
    echo "stopped"
  else
    echo "was not running"
  fi
  return 0
}

cmd_status() {
  local pid
  pid="$(read_pid || true)"
  if is_running; then
    echo "Bot Crossing: running"
    echo "  pid:  $pid"
    echo "  port: $PORT"
    echo "  url:  $URL"
    echo "  log:  $LOGFILE"
    wallpaper_status_line
    return 0
  fi
  echo "Bot Crossing: not running"
  if [ -n "$pid" ]; then
    echo "  pid:  $pid (stale pidfile — process gone or not answering)"
  else
    echo "  pid:  —"
  fi
  echo "  port: $PORT"
  echo "  url:  $URL"
  echo "  log:  $LOGFILE"
  wallpaper_status_line
  return 1
}

cmd_toggle() {
  if is_running; then
    cmd_stop
    notify "Stopped — nothing running now."
  else
    cmd_start "$@"
    notify "Running at $URL"
  fi
}

cmd_open() {
  if ! is_running; then
    cmd_start --no-open
  fi
  # `open` was asked for explicitly, so it opens the browser even when the start above was
  # told not to — BOT_CROSSING_NO_OPEN is about incidental opens, not this one.
  open "$URL" >/dev/null 2>&1 || true
  echo "Opened $URL"
}

cmd_restart() {
  cmd_stop || true
  cmd_start "$@"
}

cmd_logs() {
  : >>"$LOGFILE"
  tail -n 50 -f "$LOGFILE"
}

cmd_build() {
  pick_node
  ensure_deps
  run_build
}

# ---------------------------------------------------------------------------
# Wallpaper
# ---------------------------------------------------------------------------

# pid_is_wallpaper PID — the same rule as pid_is_server, for the wallpaper's own binary: a
# pidfile that outlived a reboot must never be allowed to kill a stranger.
pid_is_wallpaper() {
  local pid="${1:-}" cmd
  [ -n "$pid" ] || return 1
  cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
  case "$cmd" in
    *"$WP_EXE_NAME"*) return 0 ;;
    *) return 1 ;;
  esac
}

# wp_is_running — a recorded process that is alive and really is ours. There is no port to probe
# here (the wallpaper listens to nothing), so the command line is the whole check.
wp_is_running() {
  local pid
  pid="$(read_pid "$WP_PIDFILE" || true)"
  [ -n "$pid" ] || return 1
  pid_alive "$pid" || return 1
  pid_is_wallpaper "$pid" || return 1
  return 0
}

# wp_needs_build — the binary is missing or older than the source. Same bargain as needs_build
# above: swiftc costs a few seconds and the usual answer is that nothing changed.
wp_needs_build() {
  [ -f "$WP_EXE" ] || return 0
  [ "$WP_SOURCE" -nt "$WP_EXE" ]
}

cmd_wallpaper_build() {
  if [ ! -f "$WP_SOURCE" ]; then
    echo "wallpaper: missing $WP_SOURCE" >&2
    return 1
  fi
  if ! command -v swiftc >/dev/null 2>&1; then
    echo "wallpaper: no swiftc on PATH — install Apple's Command Line Tools with" >&2
    echo "           xcode-select --install" >&2
    return 1
  fi

  echo "Building the wallpaper…"
  # Rebuild the bundle rather than write into the old one: a half-replaced .app whose signature
  # no longer matches its binary is refused by the system with a message nobody can read.
  rm -rf "$WP_APP"
  mkdir -p "$WP_APP/Contents/MacOS"

  # -parse-as-library because a single .swift file is otherwise compiled in script mode, where
  # @main is an error; -swift-version 5 because Swift 6's strict concurrency has opinions about
  # AppKit callbacks that would cost more ceremony than the file is worth. Both are explained at
  # the top of the source.
  swiftc -O -swift-version 5 -parse-as-library \
    -framework Cocoa -framework WebKit \
    -o "$WP_EXE" "$WP_SOURCE"

  # LSUIElement matches the .accessory activation policy the app sets at runtime: no Dock tile,
  # no menu bar. NSAllowsLocalNetworking is the one that actually matters — without it App
  # Transport Security refuses plain http:// inside WKWebView, and the wallpaper would sit black
  # forever in front of a server that was answering perfectly well.
  cat >"$WP_APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.botcrossing.wallpaper</string>
  <key>CFBundleName</key><string>Bot Crossing Wallpaper</string>
  <key>CFBundleExecutable</key><string>Bot Crossing Wallpaper</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key><true/>
  </dict>
</dict>
</plist>
PLIST

  # Ad-hoc ("-"), and that is enough on purpose. This bundle is built on the machine it runs on
  # and is never distributed, so a Developer ID would buy nothing: what the signature is for here
  # is that Apple Silicon refuses to run an unsigned binary at all, and that the signature covers
  # Info.plist — which we just wrote, invalidating the one swiftc applied on its own.
  if ! codesign --force --sign - "$WP_APP" 2>/dev/null; then
    echo "wallpaper: codesign failed — the app will probably refuse to launch" >&2
    return 1
  fi

  echo "Built: $WP_APP"
}

ensure_wp_build() {
  if wp_needs_build; then
    cmd_wallpaper_build
  fi
}

cmd_wallpaper_start() {
  local display="" url="" interactive=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --display)
        [ $# -ge 2 ] || { echo "wallpaper start: --display needs a value" >&2; return 2; }
        display="$2"
        shift
        ;;
      --url)
        [ $# -ge 2 ] || { echo "wallpaper start: --url needs a value" >&2; return 2; }
        url="$2"
        shift
        ;;
      --interactive) interactive=1 ;;
      *) echo "wallpaper start: unknown option '$1'" >&2; return 2 ;;
    esac
    shift
  done

  if wp_is_running; then
    echo "Wallpaper already running (pid $(read_pid "$WP_PIDFILE"), log $WP_LOGFILE)"
    return 0
  fi

  # A pidfile can survive a crash or a reboot; clear it before starting so `status` never reports
  # a PID belonging to nothing.
  rm -f "$WP_PIDFILE"

  # The page is nothing without the server, so bring that up first — with --no-open, because a
  # wallpaper has no business throwing a browser window at you.
  if ! is_running; then
    cmd_start --no-open
  fi

  ensure_wp_build

  [ -n "$url" ] || url="$WP_URL_DEFAULT"
  local args
  args=(--url "$url" --log "$WP_LOGFILE")
  if [ -n "$display" ]; then args+=(--display "$display"); fi
  if [ "$interactive" -eq 1 ]; then args+=(--interactive); fi

  # Detached exactly like the server: nohup, all three streams redirected, disown. The bundle's
  # binary is run directly rather than through `open` — `open` hands the app to launchd and
  # returns, and we would never learn the PID we are expected to be able to stop. Launching the
  # executable inside the bundle still gets us the bundle: the Info.plist next to it is what
  # LSUIElement and the ATS exception are read from.
  nohup "$WP_EXE" "${args[@]}" >>"$WP_LOGFILE" 2>&1 </dev/null &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  printf '%s\n' "$pid" >"$WP_PIDFILE"

  # There is no port to poll, so all we can confirm is that it did not fall over immediately —
  # which is what a missing framework or a refused signature looks like.
  local waited=0
  while [ "$waited" -lt 4 ]; do
    if ! pid_alive "$pid"; then
      rm -f "$WP_PIDFILE"
      echo "Wallpaper failed to start — last lines of $WP_LOGFILE:" >&2
      tail -n 20 "$WP_LOGFILE" >&2 || true
      return 1
    fi
    sleep 0.25
    waited=$((waited + 1))
  done

  echo "Wallpaper running on ${display:-secondary} → $url (pid $pid, log $WP_LOGFILE)"
  notify "Wallpaper running on ${display:-secondary}"
}

cmd_wallpaper_stop() {
  local pid stopped=0

  pid="$(read_pid "$WP_PIDFILE" || true)"
  if [ -n "$pid" ] && pid_alive "$pid"; then
    # Same rule as the server's stop: only ever signal a process whose command line says it is
    # ours. Unlike the server there is no port to sweep afterwards, so there is no second chance
    # here — and hunting the whole process table for a likely-looking stray is exactly the
    # guessing this rule exists to prevent.
    if pid_is_wallpaper "$pid"; then
      kill -TERM "$pid" 2>/dev/null || true
      local waited=0
      while [ "$waited" -lt 12 ] && pid_alive "$pid"; do
        sleep 0.25
        waited=$((waited + 1))
      done
      if pid_alive "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
        sleep 0.25
      fi
      stopped=1
    else
      echo "note: pid $pid in $WP_PIDFILE is not the wallpaper — left alone" >&2
    fi
  fi
  rm -f "$WP_PIDFILE"

  if [ "$stopped" -eq 1 ]; then
    echo "stopped"
  else
    echo "was not running"
  fi
  return 0
}

cmd_wallpaper_status() {
  local pid
  pid="$(read_pid "$WP_PIDFILE" || true)"
  if wp_is_running; then
    echo "Bot Crossing wallpaper: running"
    echo "  pid:  $pid"
    echo "  app:  $WP_APP"
    echo "  log:  $WP_LOGFILE"
    return 0
  fi
  echo "Bot Crossing wallpaper: not running"
  if [ -n "$pid" ]; then
    echo "  pid:  $pid (stale pidfile — process gone)"
  else
    echo "  pid:  —"
  fi
  if [ -f "$WP_EXE" ]; then
    echo "  app:  $WP_APP"
  else
    echo "  app:  not built yet (bot-crossing wallpaper build)"
  fi
  echo "  log:  $WP_LOGFILE"
  return 1
}

# One line for the end of the plain `status`; the full picture is in `wallpaper status`.
wallpaper_status_line() {
  local pid
  pid="$(read_pid "$WP_PIDFILE" || true)"
  if wp_is_running; then
    echo "  wallpaper: running (pid $pid, log $WP_LOGFILE)"
  else
    echo "  wallpaper: not running"
  fi
}

cmd_wallpaper() {
  local sub="${1:-status}"
  if [ $# -gt 0 ]; then shift; fi
  case "$sub" in
    build) cmd_wallpaper_build ;;
    start) cmd_wallpaper_start "$@" ;;
    stop) cmd_wallpaper_stop ;;
    status) cmd_wallpaper_status ;;
    help | -h | --help)
      echo "wallpaper build | start [--display X] [--url U] [--interactive] | stop | status"
      ;;
    *)
      echo "wallpaper: unknown subcommand '$sub' (build, start, stop, status)" >&2
      return 2
      ;;
  esac
}

APP_PATH="$ROOT/Bot Crossing.app"

cmd_install_app() {
  # osacompile turns a one-line AppleScript into a real, double-clickable .app. `do shell
  # script` runs it without opening a Terminal window, which is the whole point: the Dock
  # icon should behave like an app, not like a script.
  # Two layers of quoting, in this order:
  #  1. shell — wrap the path in single quotes so spaces survive (this repo lives under
  #     "Claude Code"), turning any embedded quote into the usual '\'' dance;
  #  2. AppleScript — the result is pasted inside a double-quoted AppleScript string, so
  #     backslashes and double quotes have to be escaped again for the compiler.
  local sq="'" sq_esc="'\\''" shell_cmd apple_cmd
  shell_cmd="'${SELF_PATH//$sq/$sq_esc}' toggle"
  apple_cmd="${shell_cmd//\\/\\\\}"
  apple_cmd="${apple_cmd//\"/\\\"}"

  rm -rf "$APP_PATH"
  osacompile -o "$APP_PATH" -e "do shell script \"$apple_cmd\""
  echo "Created: $APP_PATH"
  echo
  echo "Drag \"Bot Crossing.app\" from the Finder onto your Dock."
  echo "Click once to build (if needed), start the server and open $URL."
  echo "Click again to stop it — nothing runs in between."
  echo
  echo "Open the folder now with:  open \"$ROOT\""
}

cmd_uninstall_app() {
  if [ -d "$APP_PATH" ]; then
    rm -rf "$APP_PATH"
    echo "Removed: $APP_PATH"
    echo "If you dragged it to the Dock, remove the leftover icon there too."
  else
    echo "Nothing to remove — no app at $APP_PATH"
  fi
}

usage() {
  cat <<USAGE
Bot Crossing — local launcher

Usage: bot-crossing <command>

  start [--no-open]  Build if needed, start the server, open the browser
  stop               Stop the wallpaper and the server; leave nothing running
  toggle             Stop if running, otherwise start (with a notification)
  open               Start if needed, then open $URL
  restart            Stop, then start
  status             Say whether it is running (exit 0 running, 1 not)
  logs               Follow $LOGFILE
  build              Force a production build
  install-app        Create "Bot Crossing.app" for the Dock (a toggle button)
  uninstall-app      Delete that app
  wallpaper <sub>    Live desktop wallpaper (see below)
  help               This text

Wallpaper — the colony behind your windows, on one display:

  wallpaper build    Compile wallpaper/BotCrossingWallpaper.swift into
                     "wallpaper/build/Bot Crossing Wallpaper.app"
  wallpaper start [--display X] [--url U] [--interactive]
                     Start the server if needed, build if needed, then show it.
                     --display main | secondary | index N | part of a screen's
                     name (default secondary, falling back to main when that is
                     the only screen). --interactive lets clicks through to the
                     page; by default the window ignores the mouse entirely.
  wallpaper stop     Stop it and leave nothing behind
  wallpaper status   Say whether it is running (exit 0 running, 1 not)

Environment:
  PORT                  Port to serve on (default 5274)
  BOT_CROSSING_HOST     Address to bind (default 127.0.0.1)
  BOT_CROSSING_NO_OPEN  Set to 1 to never open a browser
USAGE
}

# ---------------------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  case "$cmd" in
    start) cmd_start "$@" ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    toggle) cmd_toggle "$@" ;;
    open) cmd_open ;;
    restart) cmd_restart "$@" ;;
    logs) cmd_logs ;;
    build) cmd_build ;;
    install-app) cmd_install_app ;;
    uninstall-app) cmd_uninstall_app ;;
    wallpaper) cmd_wallpaper "$@" ;;
    help | -h | --help) usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      echo >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
